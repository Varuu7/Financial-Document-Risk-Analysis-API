# ==============================================================================
# Financial Document Risk Analysis API - Environment Configuration
# ==============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True
API_V1_PREFIX=/api/v1

# Device Configuration: 'auto', 'cpu', or 'cuda'
DEVICE=auto

# Model Identifiers
FINBERT_MODEL_NAME=ProsusAI/finbert
BERT_RISK_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Generative AI Configuration
# Set your Google Gemini API key to enable live LLM generation.
# If left empty, the API uses a robust built-in financial risk synthesizer engine.
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.0-flash

# Inference Settings
MAX_TEXT_LENGTH=50000
CHUNK_SIZE=500
CHUNK_OVERLAP=50
CONFIDENCE_THRESHOLD=0.60
